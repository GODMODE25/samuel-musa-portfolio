---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Samuel Musa — Graphic Designer',
  description = 'Posters, branding, digital & AI art by Samuel Musa',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-zinc-100 antialiased">
    <header class="sticky top-0 z-50 border-b border-white/5 bg-background/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href="/" class="font-display text-lg font-semibold tracking-tight hover:text-accent transition-colors">
          Samuel Musa
        </a>
        <div class="flex items-center gap-6 text-sm font-medium text-muted">
          <a href="/#work" class="hover:text-white transition-colors">Work</a>
          <a href="/about" class="hover:text-white transition-colors">About</a>
          <a href="/contact" class="hover:text-white transition-colors">Contact</a>
        </div>
      </nav>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="mt-24 border-t border-white/5">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-12 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {new Date().getFullYear()} Samuel Musa</p>
        <div class="flex flex-wrap gap-6">
          <a href="https://github.com/GODMODE25" target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/godmode26" target="_blank" rel="noopener" class="hover:text-white transition-colors">LinkedIn</a>
          <a href="https://instagram.com/motivatestation" target="_blank" rel="noopener" class="hover:text-white transition-colors">Instagram</a>
        </div>
      </div>
    </footer>
  </body>
</html>
