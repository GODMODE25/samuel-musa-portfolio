---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Samuel Musa">
  <section class="mx-auto max-w-2xl px-5 py-16 md:py-24">
    <h1 class="font-display text-4xl font-bold tracking-tight md:text-5xl">About</h1>
    <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
      <p>Samuel Musa is a graphic designer focused on posters, branding, and digital art. The work here is print-first when it needs to be read in a room, and image-first when the picture should do the talking. Dark, high contrast, and intentional.</p>
      <p>Open to commissions and collaborations.</p>
    </div>
    <div class="mt-10 flex flex-wrap gap-6 text-sm">
      <a href="https://samuelmusaportfolio.vercel.app" target="_blank" rel="noopener" class="hover:text-accent">Portfolio →</a>
      <a href="https://github.com/GODMODE25" target="_blank" rel="noopener" class="hover:text-accent">GitHub →</a>
      <a href="https://www.linkedin.com/in/godmode26" target="_blank" rel="noopener" class="hover:text-accent">LinkedIn →</a>
      <a href="https://instagram.com/motivatestation" target="_blank" rel="noopener" class="hover:text-accent">Instagram →</a>
    </div>
  </section>
</BaseLayout>
