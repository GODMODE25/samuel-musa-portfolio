---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Samuel Musa">
  <section class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-10">About</h1>
    
    <div class="space-y-6 text-muted">
      <p class="text-xl text-zinc-100 leading-relaxed">
        I’m Samuel Musa — a graphic designer focused on bold posters, branding systems, and digital art.
      </p>
      
      <p>
        My work spans event graphics, business identity, AI-assisted concept art, and dark atmospheric wallpapers. 
        I care about strong visual hierarchy, high contrast, and pieces that feel intentional.
      </p>

      <p>
        Currently open to freelance collaborations and commissions.
      </p>
    </div>

    <div class="mt-16 pt-10 border-t border-white/10">
      <h2 class="text-sm uppercase tracking-wider text-muted mb-6">Connect</h2>
      <div class="flex flex-wrap gap-6 text-sm">
        <a href="https://github.com/GODMODE25" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
          GitHub →
        </a>
        <a href="https://www.linkedin.com/in/godmode26" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
          LinkedIn →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
