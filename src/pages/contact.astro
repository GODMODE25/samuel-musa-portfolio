---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Samuel Musa">
  <section class="max-w-2xl mx-auto px-6 py-16 md:py-24">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">Let’s work together</h1>
    <p class="text-muted text-lg mb-12">
      Available for posters, branding, event graphics, and digital art commissions.
    </p>

    <div class="space-y-8">
      <div>
        <p class="text-sm uppercase tracking-wider text-muted mb-2">Email</p>
        <a href="mailto:hello@samuelmusa.com" class="text-xl hover:text-accent transition-colors">
          hello@samuelmusa.com
        </a>
      </div>

      <div>
        <p class="text-sm uppercase tracking-wider text-muted mb-2">Social</p>
        <div class="flex flex-col gap-3">
          <a href="https://github.com/GODMODE25" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
            GitHub
          </a>
          <a href="https://www.linkedin.com/in/godmode26" target="_blank" rel="noopener" class="hover:text-accent transition-colors">
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
