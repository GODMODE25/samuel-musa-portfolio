---
import BaseLayout from '../layouts/BaseLayout.astro';
import { work, categoryLabel } from '../data/work';
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 md:pb-24 md:pt-24">
    <p class="mb-4 text-xs font-medium uppercase tracking-widest text-accent">Graphic design</p>
    <h1 class="font-display text-5xl font-bold leading-none tracking-tight md:text-7xl">Samuel Musa</h1>
    <p class="mt-6 max-w-xl text-xl leading-relaxed text-muted md:text-2xl">
      Posters, branding, and digital art — built to hold a wall, a card, or a screen.
    </p>
  </section>

  <section id="work" class="mx-auto max-w-6xl px-5 pb-16">
    <div class="mb-8">
      <h2 class="font-display text-3xl font-semibold tracking-tight">Selected work</h2>
      <p class="mt-2 text-sm text-muted">{work.length} pieces across print, identity, and digital art.</p>
    </div>

    <div class="mb-8 flex flex-wrap gap-2" id="filters">
      <button type="button" data-filter="all" class="filter-btn min-h-11 rounded-full border border-accent bg-accent px-4 text-sm text-background">All</button>
      <button type="button" data-filter="posters" class="filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted">Posters</button>
      <button type="button" data-filter="branding" class="filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted">Branding</button>
      <button type="button" data-filter="ai" class="filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted">AI & Digital</button>
      <button type="button" data-filter="wallpapers" class="filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted">Wallpapers</button>
      <button type="button" data-filter="personal" class="filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted">Personal</button>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {work.map((item) => (
        <a href={`/work/${item.slug}`} data-category={item.category} class="work-card group block overflow-hidden rounded-xl border border-white/5 bg-surface">
          <div class="frame relative overflow-hidden bg-surface-elevated">
            <img src={item.image} alt={item.title} class="thumb" loading="lazy" />
          </div>
          <div class="flex items-baseline justify-between gap-3 px-4 py-4">
            <div>
              <p class="text-xs uppercase tracking-wider text-accent">{categoryLabel[item.category]}</p>
              <h3 class="mt-1 text-base font-medium text-white">{item.title}</h3>
            </div>
            <span class="text-xs text-muted">{item.year}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.work-card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter') || 'all';
        buttons.forEach((b) => {
          const active = b === btn;
          b.className = active
            ? 'filter-btn min-h-11 rounded-full border border-accent bg-accent px-4 text-sm text-background'
            : 'filter-btn min-h-11 rounded-full border border-white/10 bg-surface px-4 text-sm text-muted';
        });
        cards.forEach((card) => {
          const show = filter === 'all' || card.getAttribute('data-category') === filter;
          (card as HTMLElement).style.display = show ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
