---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  {
    title: 'FYB Picnic',
    category: 'Poster',
    slug: 'fyb-picnic',
  },
  {
    title: 'Summer Party',
    category: 'Flyer',
    slug: 'summer-party',
  },
  {
    title: 'Business Cards',
    category: 'Branding',
    slug: 'business-cards',
  },
  {
    title: 'Futuristic Supercar',
    category: 'AI Art',
    slug: 'supercar',
  },
  {
    title: 'Abstract Series',
    category: 'Digital Art',
    slug: 'abstract',
  },
  {
    title: 'Dark Wallpapers',
    category: 'Wallpaper',
    slug: 'wallpapers',
  },
];
---

<BaseLayout>
  <section class="max-w-6xl mx-auto px-6 pt-16 pb-24 md:pt-24 md:pb-32">
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] mb-6">
      Samuel Musa
    </h1>
    <p class="text-xl md:text-2xl text-muted max-w-2xl leading-relaxed">
      Graphic Designer — Posters, Branding & Digital Art
    </p>
  </section>

  <section id="work" class="max-w-6xl mx-auto px-6 pb-24">
    <div class="flex items-end justify-between mb-10">
      <h2 class="text-2xl font-semibold tracking-tight">Selected Work</h2>
      <span class="text-sm text-muted">Featured</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((project) => (
        <a 
          href={`/work/${project.slug}`}
          class="group relative aspect-[4/5] bg-surface rounded-lg overflow-hidden border border-white/5 hover:border-white/10 transition-all duration-300"
        >
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10" />
          
          <div class="absolute inset-0 bg-surface-elevated flex items-center justify-center">
            <span class="text-muted text-sm">{project.category}</span>
          </div>

          <div class="absolute bottom-0 left-0 right-0 p-5 z-20 translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
            <p class="text-xs uppercase tracking-wider text-accent mb-1">{project.category}</p>
            <h3 class="text-lg font-medium text-white">{project.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
