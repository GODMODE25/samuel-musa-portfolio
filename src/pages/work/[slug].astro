---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { work, getWork, categoryLabel } from '../../data/work';

export function getStaticPaths() {
  return work.map((item) => ({
    params: { slug: item.slug },
  }));
}

const { slug } = Astro.params;
const item = getWork(slug!);
if (!item) {
  return Astro.redirect('/');
}
const index = work.findIndex((entry) => entry.slug === item.slug);
const prev = work[(index - 1 + work.length) % work.length];
const next = work[(index + 1) % work.length];
---

<BaseLayout title={`${item.title} — Samuel Musa`}>
  <article class="mx-auto max-w-5xl px-5 pb-16 pt-10">
    <a href="/#work" class="text-sm text-muted hover:text-white">← All work</a>
    <p class="mt-8 text-xs uppercase tracking-wider text-accent">{categoryLabel[item.category]}</p>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-display text-4xl font-bold tracking-tight md:text-6xl">{item.title}</h1>
      <span class="text-sm text-muted">{item.year}</span>
    </div>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{item.note}</p>
    <div class="mt-8 overflow-hidden rounded-xl border border-white/5 bg-surface">
      <img src={item.image} alt={item.title} class="mx-auto max-h-[80vh] w-full object-contain" />
    </div>
    <div class="mt-12 flex items-center justify-between border-t border-white/10 pt-6 text-sm">
      <a href={`/work/${prev.slug}`} class="text-muted hover:text-white">← {prev.title}</a>
      <a href={`/work/${next.slug}`} class="text-muted hover:text-white">{next.title} →</a>
    </div>
  </article>
</BaseLayout>
